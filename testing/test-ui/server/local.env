# Database Settings
DATABASE_DIALECT=sqlite
DATABASE_STORAGE=vet-clinic.sqlite
DATABASE_LOGGING=false

# Disable Auth for Test UI / Local Dev
AUTH_DISABLE_FOR_DEV=true

# Controls which Meta objects can be edited in this environment (Entity, Menu, Page, Role)
# Case-sensitive comma-separated list, or empty string to disable all. Must be defined.
META_EDIT_ENABLED=Entity,Menu,Page,Role

# Metadata Location
META_SOURCE_LOCATION=local
META_SOURCE_LOCATION_DIR=../meta
META_BUCKET_NAME=unused-local

# Media Location
MEDIA_REPOSITORY=local
MEDIA_DIR=./media

# Server Port
PORT=3080
