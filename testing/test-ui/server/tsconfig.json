{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": "./",
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "paths": {
      "@perfect-stack/nestjs-server": [
        "../../../nestjs-server/libs/nestjs-server/src"
      ],
      "@perfect-stack/nestjs-server/*": [
        "../../../nestjs-server/libs/nestjs-server/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
