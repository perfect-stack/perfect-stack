# Disables authentication for local development
AUTH_DISABLE_FOR_DEV=false

# Controls which Meta objects can be edited in this environment (Entity, Menu, Page, Role)
# Case-sensitive comma-separated list, or empty string to disable all. Must be defined.
META_EDIT_ENABLED=Entity,Menu,Page,Role

# Source location strategy how to load the meta files from (s3, local)
META_SOURCE_LOCATION=local

# Dir of where the meta files are
META_SOURCE_LOCATION_DIR=meta

# S3 bucket for media files
MEDIA_REPOSITORY=local
MEDIA_DIR_NAME=test-media

# Defines how Jobs should be processed (sync | async)
JOB_PROCESSING_MODE=local-async
