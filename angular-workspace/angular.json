{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-perfect-stack": {
      "projectType": "library",
      "root": "projects/ngx-perfect-stack",
      "sourceRoot": "projects/ngx-perfect-stack/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngx-perfect-stack/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-perfect-stack/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-perfect-stack/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ngx-perfect-stack/src/test.ts",
            "tsConfig": "projects/ngx-perfect-stack/tsconfig.spec.json",
            "karmaConfig": "projects/ngx-perfect-stack/karma.conf.js"
          }
        }
      }
    },
    "demo-client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/demo-client",
      "sourceRoot": "projects/demo-client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "preserveSymlinks": true,
            "outputPath": {
              "base": "dist/demo-client"
            },
            "index": "projects/demo-client/src/index.html",
            "polyfills": [
              "projects/demo-client/src/polyfills.ts"
            ],
            "tsConfig": "projects/demo-client/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/demo-client/src/client.json",
              "projects/demo-client/src/client-overrides.json",
              "projects/demo-client/src/favicon.ico",
              "projects/demo-client/src/assets",
              {
                "glob": "**/*",
                "input": "node_modules/tinymce",
                "output": "/tinymce/"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/leaflet/dist/leaflet.css",
              "projects/demo-client/src/styles.scss"
            ],
            "scripts": [
              "node_modules/tinymce/tinymce.min.js"
            ],
            "browser": "projects/demo-client/src/main.ts",
            "allowedCommonJsDependencies": [
              "tinymce",
              "leaflet",
              "proj4",
              "ng-drag-drop"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/demo-client/src/environments/environment.ts",
                  "with": "projects/demo-client/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "preserveSymlinks": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "preserveSymlinks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo-client:build:production"
            },
            "development": {
              "buildTarget": "demo-client:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "demo-client:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/demo-client/src/test.ts",
            "polyfills": "projects/demo-client/src/polyfills.ts",
            "tsConfig": "projects/demo-client/tsconfig.spec.json",
            "karmaConfig": "projects/demo-client/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/demo-client/src/favicon.ico",
              "projects/demo-client/src/assets"
            ],
            "styles": [
              "projects/demo-client/src/styles.scss"
            ],
            "scripts": [
              "node_modules/tinymce/tinymce.min.js"
            ]
          }
        }
      }
    },
    "capture-client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/capture-client",
      "sourceRoot": "projects/capture-client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "preserveSymlinks": true,
            "outputPath": {
              "base": "dist/capture-client"
            },
            "index": "projects/capture-client/src/index.html",
            "browser": "projects/capture-client/src/main.ts",
            "polyfills": [
              "projects/capture-client/src/polyfills.ts"
            ],
            "tsConfig": "projects/capture-client/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/capture-client/src/client.json",
              "projects/capture-client/src/client-overrides.json",
              "projects/capture-client/src/favicon.ico",
              "projects/capture-client/src/assets",
              {
                "glob": "**/*",
                "input": "node_modules/tinymce",
                "output": "/tinymce/"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/leaflet/dist/leaflet.css",
              "projects/capture-client/src/styles.scss"
            ],
            "scripts": [
              "node_modules/tinymce/tinymce.min.js"
            ],
            "allowedCommonJsDependencies": [
              "tinymce",
              "leaflet",
              "proj4",
              "ng-drag-drop"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all",
              "preserveSymlinks": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "preserveSymlinks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "capture-client:build:production"
            },
            "development": {
              "buildTarget": "capture-client:build:development",
              "port": 4200,
              "ssl": true
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/capture-client/src/test.ts",
            "polyfills": [
              "projects/capture-client/src/polyfills.ts"
            ],
            "tsConfig": "projects/capture-client/tsconfig.spec.json",
            "karmaConfig": "projects/capture-client/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/capture-client/src/favicon.ico",
              "projects/capture-client/src/assets"
            ],
            "styles": [
              "projects/capture-client/src/styles.scss"
            ],
            "scripts": [
              "node_modules/tinymce/tinymce.min.js"
            ]
          }
        }
      }
    },
    "test-ui-client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
