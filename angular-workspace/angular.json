            },
            "index": "projects/test-ui-client/src/index.html",
            "polyfills": [
              "projects/test-ui-client/src/polyfills.ts"
            ],
            "tsConfig": "projects/test-ui-client/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/test-ui-client/src/client.json",
              "projects/test-ui-client/src/client-overrides.json",
              "projects/test-ui-client/src/favicon.ico",
              "projects/test-ui-client/src/assets",
              {
