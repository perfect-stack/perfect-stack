    "build:lib": "ng build ngx-perfect-stack",
    "build:lib:yalc": "nodemon --watch projects/ngx-perfect-stack --ext ts,html,scss,css,json --exec \"ng build ngx-perfect-stack && cd dist/ngx-perfect-stack && yalc push\"",
